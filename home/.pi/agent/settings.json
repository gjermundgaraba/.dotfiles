{
  "packages": [
    {
      "source": "npm:@clanker-stuff/ask-question@0.1.0",
      "extensions": [
        "-index.ts"
      ]
    },
    "npm:@clanker-stuff/dollah-skills@0.1.0",
    "npm:@clanker-stuff/history@0.1.0",
    "npm:@clanker-stuff/shell-resume-history@0.1.0",
    "npm:@clanker-stuff/plannotator@0.2.0",
    {
      "source": "npm:@clanker-stuff/footer@0.1.0",
      "extensions": [
        "+index.ts"
      ]
    },
    {
      "source": "npm:@clanker-stuff/usage@0.1.0",
      "extensions": [
        "+index.ts"
      ]
    },
    {
      "source": "npm:@clanker-stuff/fast@0.1.0",
      "extensions": [
        "-index.ts"
      ]
    },
    {
      "source": "npm:@clanker-stuff/subagents@0.1.0",
      "extensions": [
        "-index.ts"
      ]
    },
    {
      "source": "npm:@clanker-stuff/shape-spinner@0.1.0",
      "extensions": [
        "-index.ts"
      ]
    },
    {
      "source": "npm:@earendil-works/pi-radius",
      "extensions": [
        "-extensions/radius-mcp-migration.ts",
        "-extensions/radius-notices.ts",
        "-extensions/radius-routing.ts",
        "-extensions/radius-web-search.ts"
      ],
      "skills": [
        "-skills/radius-api/SKILL.md"
      ]
    },
    {
      "source": "npm:@clanker-stuff/background-tasks@0.1.0",
      "extensions": [
        "-index.ts"
      ],
      "skills": [
        "-skills/watchers/SKILL.md"
      ]
    },
    "npm:@clanker-stuff/context@0.1.0",
    {
      "source": "npm:@clanker-stuff/vim@0.1.0",
      "extensions": [
        "-index.ts"
      ]
    },
    "npm:@clanker-stuff/turn-recap@0.1.0",
    "npm:@clanker-stuff/claude-bridge@0.1.0",
    "npm:@clanker-stuff/mcp-skills@0.1.0",
    "npm:@clanker-stuff/codemode-diffs@0.1.0",
    "npm:@aliou/pi-ts-aperture"
  ],
  "defaultProvider": "openai",
  "defaultModel": "gpt-6-astra",
  "defaultTools": [
    "+codemode"
  ],
  "codemode": {
    "mode": "only"
  },
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "xai/grok-4.6": "xhigh",
    "radius/deepseek-v4.1-flash": "high"
  },
  "treeFilterMode": "no-tools",
  "enabledModels": [
    "opencode-go/kimi-k3",
    "github-copilot/grok-4.6",
    "xai/grok-4.6",
    "cursorapi/grok-4.6",
    "cursorapi/grok-4.6-fast",
    "radius/deepseek-v4.1-flash",
    "radius/cheap",
    "radius/balanced",
    "radius/precise",
    "openrouter/openai/gpt-6.1-sol",
    "openrouter/openai/gpt-6-astra",
    "claude-bridge/claude-opus-5-5",
    "claude-bridge/claude-sonnet-5-5",
    "claude-bridge/claude-fable-5-1",
    "openai/gpt-6.1-sol",
    "openai/gpt-6-astra",
    "aperture/aperture/anthropic/claude-sonnet-5.5"
  ],
  "showHardwareCursor": true,
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "gg-light/gg-dark",
  "outputPad": 0,
  "showCacheMissNotices": true,
  "defaultProjectTrust": "always",
  "tuiMode": "fullscreen",
  "editorPaddingX": 1,
  "enableSkillCommands": true,
  "hideThinkingBlock": false,
  "extensions": [
    "+extensions/herdr-micro-effort.ts"
  ]
}
